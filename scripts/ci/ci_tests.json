{
  "//schema": [
    "SGLang CI 动态测试配置",
    "",
    "所有 target 字段都支持动态语法：",
    "  file_patterns:  glob 模式，运行时展开    test/registered/quant/test_*.py",
    "  test_patterns:  方法级 glob 模式          **/test_metrics.py::Test*::test_*",
    "  greps:          关键词匹配（CI 注册表）   eagle, moe, penalty",
    "  suite_patterns: suite 名通配              stage-b-*-1-gpu",
    "  exclude:        排除模式                  *benchmark*, *perf*",
    "  filters:        条件过滤                  { max_est_time: 60 }",
    "",
    "  $VAR 变量：在 vars 或 CLI --var KEY=VAL 中定义，所有字符串字段自动替换",
    "",
    "用法：",
    "  ./run_ci.sh run -c ci_tests.json -p quick-unit",
    "  ./run_ci.sh run -c ci_tests.json -p quick-unit --var HW=amd",
    "  ./run_ci.sh run -c ci_tests.json -p quick-unit -f extra_file.py",
    "  ./run_ci.sh list -c ci_tests.json"
  ],

  "vars": {
    "HW": "cuda",
    "TIMEOUT": "600",
    "MAX_EST": "120"
  },

  "quick-unit": {
    "description": "快速单元测试：glob 自动匹配所有 unit 文件，过滤 est_time < $MAX_EST",
    "hw": "$HW",
    "timeout": "$TIMEOUT",
    "continue_on_error": true,
    "file_patterns": [
      "test/registered/unit/mem_cache/test_*_unit.py",
      "test/registered/unit/mem_cache/test_swa_unittest.py",
      "test/registered/unit/mem_cache/test_mamba_unittest.py",
      "test/registered/unit/entrypoints/openai/test_protocol*.py",
      "test/registered/unit/entrypoints/openai/test_serving_chat.py",
      "test/registered/unit/entrypoints/openai/test_serving_completions.py",
      "test/registered/unit/entrypoints/openai/test_serving_embedding.py",
      "test/registered/prefill_only/test_serving_rerank.py",
      "test/registered/unit/server_args/test_server_args.py",
      "test/registered/unit/managers/test_io_struct.py",
      "test/registered/core/test_request_queue_validation.py"
    ],
    "test_patterns": [
      "test/registered/observability/test_metrics.py::TestComputeRoutingKeyStats::test_*"
    ],
    "exclude": ["*benchmark*", "*perf*"],
    "filters": {
      "max_est_time": "$MAX_EST"
    }
  },

  "kernel-sanity": {
    "description": "Kernel 算子验证：kernels/quant/ops/moe/mla/attention 算子层测试",
    "hw": "$HW",
    "timeout": "300",
    "continue_on_error": true,
    "file_patterns": [
      "test/registered/kernels/test_*.py",
      "test/registered/quant/test_*kernel*.py",
      "test/registered/quant/test_*scaled*.py",
      "test/registered/quant/test_int8*.py",
      "test/registered/quant/test_fp8_utils.py",
      "test/registered/quant/test_triton_scaled_mm.py",
      "test/registered/ops/test_*.py",
      "test/registered/moe/test_fused_moe.py",
      "test/registered/moe/test_triton_fused_moe.py",
      "test/registered/moe/test_triton_moe_channel_fp8_kernel.py",
      "test/registered/mla/test_flashmla.py",
      "test/registered/mla/test_mla_fp8.py",
      "test/registered/attention/test_create_kvindices.py",
      "test/registered/attention/test_triton_attention_kernels.py",
      "test/registered/attention/test_kda_kernels.py",
      "test/registered/layers/mamba/test_mamba_ssm.py",
      "test/registered/layers/mamba/test_mamba_ssm_ssd.py",
      "test/registered/layers/mamba/test_causal_conv1d.py"
    ],
    "exclude": ["*benchmark*"]
  },

  "pre-commit": {
    "description": "提交前检查：stage-a 全量 + unit + server_args + metrics method",
    "hw": "$HW",
    "continue_on_error": true,
    "retry": true,
    "suite_patterns": ["stage-a-*"],
    "file_patterns": [
      "test/registered/unit/mem_cache/test_*_unit.py",
      "test/registered/unit/mem_cache/test_swa_unittest.py",
      "test/registered/unit/mem_cache/test_mamba_unittest.py",
      "test/registered/unit/entrypoints/openai/test_protocol*.py",
      "test/registered/unit/server_args/test_server_args.py",
      "test/registered/unit/managers/test_io_struct.py"
    ],
    "test_patterns": [
      "test/registered/observability/test_metrics.py::TestComputeRoutingKeyStats::*"
    ]
  },

  "sampling-focus": {
    "description": "采样专项：penalty / logprobs / pytorch_sampling / original_logprobs",
    "hw": "$HW",
    "timeout": "$TIMEOUT",
    "continue_on_error": true,
    "file_patterns": [
      "test/registered/sampling/test_*.py"
    ],
    "test_patterns": [
      "test/registered/sampling/test_penalty.py::TestPenalty::test_*"
    ]
  },

  "all-small-1gpu": {
    "description": "所有 small-1-gpu suite（通配匹配）",
    "hw": "$HW",
    "suite_patterns": ["stage-*-small-1-gpu"],
    "continue_on_error": true,
    "retry": true,
    "max_attempts": 3,
    "filters": {
      "max_est_time": 300
    }
  },

  "full-1gpu": {
    "description": "1-GPU 全量：通配所有 stage-a + stage-b 的 1-gpu suite",
    "hw": "$HW",
    "suite_patterns": [
      "stage-a-*",
      "stage-b-*-1-gpu"
    ],
    "exclude": ["*amd*", "*mi35x*", "*ascend*", "*npu*"],
    "continue_on_error": true,
    "retry": true,
    "max_attempts": 3
  },

  "all-nightly": {
    "description": "运行所有 nightly 测试（通配匹配所有 nightly-* suite）",
    "hw": "$HW",
    "nightly": true,
    "continue_on_error": true,
    "retry": true,
    "suite_patterns": ["nightly-*"]
  },

  "b200-percommit": {
    "description": "B200 per-commit 全量：stage-a/b 全部 + b200/gb200/deepep 专属 stage-c，排除 h100/h200/h20/amd/npu",
    "hw": "cuda",
    "nightly": false,
    "continue_on_error": true,
    "retry": true,
    "max_attempts": 2,
    "timeout": "3600",
    "suite_patterns": [
      "stage-a-*",
      "stage-b-*",
      "stage-c-test-4-gpu-b200",
      "stage-c-test-4-gpu-gb200",
      "stage-c-test-deepep-4-gpu",
      "stage-c-test-8-gpu-b200"
    ],
    "exclude": [
      "*h100*", "*h200*", "*h20*",
      "*amd*", "*mi30x*", "*mi35x*",
      "*npu*", "*ascend*",
      "*benchmark*"
    ]
  },

  "b200-nightly": {
    "description": "B200 nightly 全量：所有 nightly suite，排除 h100/h200/h20/amd/npu",
    "hw": "cuda",
    "nightly": true,
    "continue_on_error": true,
    "retry": true,
    "max_attempts": 2,
    "timeout": "3600",
    "suite_patterns": [
      "nightly-1-gpu",
      "nightly-2-gpu",
      "nightly-4-gpu",
      "nightly-4-gpu-b200",
      "nightly-8-gpu-b200",
      "nightly-8-gpu-common",
      "nightly-eval-text-2-gpu",
      "nightly-eval-vlm-2-gpu",
      "nightly-perf-text-2-gpu",
      "nightly-perf-vlm-2-gpu"
    ],
    "exclude": [
      "*h100*", "*h200*", "*h20*",
      "*amd*", "*mi30x*", "*mi35x*",
      "*npu*", "*ascend*",
      "*benchmark*"
    ]
  },

  "by-category": {
    "description": "按目录类别选择：attention/scheduler/radix_cache/moe/mla/quant/spec/distributed",
    "hw": "$HW",
    "continue_on_error": true,
    "file_patterns": [
      "test/registered/attention/test_*.py",
      "test/registered/scheduler/test_*.py",
      "test/registered/radix_cache/test_*.py",
      "test/registered/moe/test_*.py",
      "test/registered/mla/test_*.py",
      "test/registered/quant/test_*.py",
      "test/registered/spec/eagle/test_eagle*.py",
      "test/registered/spec/test_spec_ngram*.py",
      "test/registered/spec/test_spec_standalone*.py",
      "test/registered/dp_attn/test_dp_attention.py",
      "test/registered/dp_engine/test_data_parallelism.py",
      "test/registered/constrained_decoding/test_*.py",
      "test/registered/disaggregation/test_*.py",
      "test/registered/hicache/test_*.py",
      "test/registered/lora/test_*.py",
      "test/registered/rl/test_*.py",
      "test/registered/vlm/test_*.py",
      "test/registered/models/test_*.py",
      "test/registered/core/test_*.py",
      "test/registered/openai_server/basic/test_*.py",
      "test/registered/openai_server/features/test_*.py",
      "test/registered/openai_server/validation/test_*.py",
      "test/registered/openai_server/function_call/test_*.py",
      "test/registered/function_call/test_*.py",
      "test/registered/tokenizer/test_*.py",
      "test/registered/dllm/test_*.py",
      "test/registered/ep/test_*.py",
      "test/registered/backends/test_*.py",
      "test/registered/debug_utils/test_*.py",
      "test/registered/model_loading/test_*.py",
      "test/registered/cuda_graph/**/*.py",
      "test/registered/layers/mamba/test_*.py",
      "test/registered/rotary/test_*.py",
      "test/registered/bench_fn/test_*.py",
      "test/registered/ops/test_*.py",
      "test/registered/kernels/test_*.py",
      "test/registered/observability/test_*.py",
      "test/registered/profiling/test_*.py",
      "test/registered/sampling/test_*.py",
      "test/registered/utils/test_*.py",
      "test/registered/eval/test_*.py",
      "test/registered/stress/test_*.py",
      "test/registered/perf/test_*.py",
      "test/registered/4-gpu-models/test_*.py",
      "test/registered/8-gpu-models/test_*.py",
      "test/registered/test_*.py"
    ],
    "exclude": [
      "*amd*", "*mi30x*", "*mi35x*",
      "*ascend*", "*npu*",
      "*h100*", "*h200*", "*h20*",
      "*benchmark*", "*wave*"
    ],
    "filters": {
      "max_est_time": 200
    }
  }
}
